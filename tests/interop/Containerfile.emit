FROM dhi.io/gradle:9-jdk25-alpine3.23-dev AS runner
WORKDIR /app
ARG HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy
ENV http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} ALL_PROXY=${ALL_PROXY}

RUN mkdir -p src/main/kotlin
COPY --from=specodec-runtime-kotlin src/commonMain/kotlin/specodec/ src/main/kotlin/specodec/
COPY --from=emit_gen TestServiceTypes.kt src/main/kotlin/alltypes/
COPY --from=emit_kotlin_src settings.gradle.kts build.gradle.kts ./
RUN printf 'import alltypes.*\n\nfun main() {\n    println("ok ${InnerCodec}")\n}\n' > src/main/kotlin/Main.kt
RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/root/.gradle/wrapper \
    gradle compileKotlin --no-daemon -q 2>&1 && echo "OK kotlin"
